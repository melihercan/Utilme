<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>UtilmeSdpTransform.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The approved public API baseline, compared at test time. -->
    <Content Include="PublicApi.approved.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SdpTransform\SdpTransform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AwesomeAssertions, not FluentAssertions: FluentAssertions went commercial at 8.0
         and 7.2.2 was the last Apache-2.0 release, so a pin was all that held the line.
         This is the fork of that release - Apache-2.0, same API. -->
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
